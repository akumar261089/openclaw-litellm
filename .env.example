# LiteLLM Master Key (set any secret string)
LITELLM_MASTER_KEY=sk-choose-any-secret-string

# Provider API Keys - only fill in the ones you plan to use
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
# Additional providers
COHERE_API_KEY=...
REPLICATE_API_KEY=...
HUGGINGFACE_API_KEY=...
MISTRAL_API_KEY=...
# Optional providers
OLLAMA_API_BASE=http://localhost:11434  # default Ollama endpoint
OLLAMA_API_KEY=ollama                  # optional, can be left empty
OPENROUTER_API_KEY=sk-or-...
GOOGLE_API_KEY=...                     # for PaLM or Gemini (if not using GEMINI_API_KEY)